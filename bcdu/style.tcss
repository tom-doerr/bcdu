Screen { background: #0b1220; color: #dce6f0; }
#brand { height: 3; background: #101d2d; align-vertical: middle; padding: 0 2; }
#logo { width: 15; color: #75e4d0; text-style: bold; }
#tagline { width: 1fr; color: #7d93aa; }
#mode { width: 12; color: #f0ba6b; text-align: right; text-style: bold; }
#path { height: 2; color: #b7c8da; padding-top: 1; }
#metrics { height: 5; margin: 1 1 0 1; }
.metric { width: 1fr; height: 4; padding: 0 2; margin: 0 1; border-left: thick #263c51; background: #101d2d; content-align-vertical: middle; }
#main { height: 1fr; margin: 0 2; }
#browser { width: 1fr; border: round #263c51; }
#browser-heading { height: 2; padding-top: 0; color: #90a6ba; background: #101d2d; }
#filter { height: 3; margin: 0 1; }
#files { height: 1fr; background: #0b1220; }
DataTable > .datatable--header { background: #15283a; color: #a5bad0; text-style: bold; }
DataTable > .datatable--cursor { background: #19483f; color: #dcfff5; text-style: bold; }
DataTable > .datatable--odd-row { background: #0f1a29; }
DataTable > .datatable--even-row { background: #0b1220; }
#details { width: 37; margin-left: 2; border: round #263c51; padding: 1 2; }
#details-body { height: auto; }
#status { height: 2; padding: 0 2; color: #90a6ba; content-align-vertical: middle; }
Footer { background: #101d2d; }
ModalScreen { align: center middle; background: #000000 65%; }
#report-dialog { width: 90%; height: 90%; background: #101d2d; border: round #3a6a75; padding: 1 2; }
.dialog-title { color: #75e4d0; text-style: bold; margin-bottom: 1; height: 2; }
#report-dialog VerticalScroll { height: 1fr; }
#report-dialog Static { height: auto; }
#report-dialog Button { margin-top: 1; }
#raw { height: 1fr; }
#edit-dialog { width: 78; max-width: 95%; height: auto; max-height: 95%; background: #101d2d; border: round #3a6a75; padding: 1 2; overflow-y: auto; }
#edit-path { height: auto; margin-bottom: 1; }
#option-help { height: auto; margin: 1 0; color: #90a6ba; }
#preview { height: auto; margin: 1 0; color: #f0ba6b; }
.buttons { height: 3; }
.buttons Button { margin-right: 1; }
